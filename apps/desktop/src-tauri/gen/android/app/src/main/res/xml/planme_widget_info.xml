<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis 的最小值就是 30 分钟，写更小的值也会被系统拉长。
  真正的实时性靠：App onPause 立即刷新 + WorkManager 15 分钟兜底 + 手动刷新按钮。
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="90dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/planme_widget"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/planme_widget" />
